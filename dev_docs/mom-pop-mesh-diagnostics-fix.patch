+    // that server, so it needs internet while it is in use.
+    'turn_urls' => array_filter(array_map('trim', explode(',', env('MESH_TURN_URLS', '')))),
+    'turn_secret' => env('MESH_TURN_SECRET'),
+    'turn_ttl' => (int) env('MESH_TURN_TTL', 3600),
